--- /dev/null
+++ b/Services/RequestServer/NetworkChange.h
@@ -0,0 +1,23 @@
+/*
+ * Copyright (c) 2026, the Iroise authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <RequestServer/CURL.h>
+
+namespace RequestServer {
+
+// NB: A connection keeps the address and the way out that it was opened with. When the network changes under it, such
+//     as when a VPN comes up or goes down, its packets go nowhere, and libcurl goes on reusing it for its host until the
+//     kernel gives up on it, minutes later. Every socket libcurl opens is known here, so that a change of the network
+//     can close the ones it stranded, and libcurl connects again (Iroise, patches/0023).
+curl_socket_t open_socket_for_curl(void*, curlsocktype, curl_sockaddr*);
+int close_socket_for_curl(void*, curl_socket_t);
+
+// Starts listening to the kernel for changes of addresses, links, routes and routing rules.
+void watch_for_network_changes();
+
+}
