index 000000000..df3785dfd
--- /dev/null
+++ b/Services/RequestServer/NetworkChange.cpp
@@ -0,0 +1,174 @@
+/*
+ * Copyright (c) 2026, the Iroise authors
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Format.h>
+#include <AK/HashTable.h>
+#include <AK/Optional.h>
+#include <AK/String.h>
+#include <LibCore/Notifier.h>
+#include <LibCore/Timer.h>
+#include <RequestServer/NetworkChange.h>
+
+#if defined(AK_OS_LINUX)
+#    include <errno.h>
+#    include <ifaddrs.h>
+#    include <linux/netlink.h>
+#    include <linux/rtnetlink.h>
+#    include <netinet/in.h>
+#    include <string.h>
+#    include <sys/socket.h>
+#    include <unistd.h>
+#endif
+
+namespace RequestServer {
+
+static HashTable<int>& sockets_of_curl()
+{
+    static HashTable<int> sockets;
+    return sockets;
+}
+
+curl_socket_t open_socket_for_curl(void*, curlsocktype, curl_sockaddr* address)
+{
+#if defined(AK_OS_LINUX)
+    auto fd = socket(address->family, address->socktype | SOCK_CLOEXEC, address->protocol);
+#else
+    auto fd = socket(address->family, address->socktype, address->protocol);
+#endif
+    if (fd < 0)
+        return CURL_SOCKET_BAD;
+    sockets_of_curl().set(fd);
+    return fd;
+}
+
+int close_socket_for_curl(void*, curl_socket_t fd)
+{
+    sockets_of_curl().remove(fd);
+    return close(fd);
+}
+
+#if defined(AK_OS_LINUX)
+
+static bool same_address(sockaddr_storage const& a, sockaddr_storage const& b)
+{
+    if (a.ss_family != b.ss_family)
+        return false;
+    if (a.ss_family == AF_INET)
+        return reinterpret_cast<sockaddr_in const&>(a).sin_addr.s_addr == reinterpret_cast<sockaddr_in const&>(b).sin_addr.s_addr;
+    if (a.ss_family == AF_INET6)
+        return memcmp(&reinterpret_cast<sockaddr_in6 const&>(a).sin6_addr, &reinterpret_cast<sockaddr_in6 const&>(b).sin6_addr, sizeof(in6_addr)) == 0;
+    return false;
+}
+
+// The interface that has the address, if any still has it.
+static Optional<String> interface_with_address(ifaddrs const* interfaces, sockaddr_storage const& address)
+{
+    for (auto const* interface = interfaces; interface; interface = interface->ifa_next) {
+        if (!interface->ifa_addr || interface->ifa_addr->sa_family != address.ss_family)
+            continue;
+        sockaddr_storage candidate {};
+        memcpy(&candidate, interface->ifa_addr, address.ss_family == AF_INET ? sizeof(sockaddr_in) : sizeof(sockaddr_in6));
+        if (same_address(candidate, address))
+            return MUST(String::from_utf8(StringView { interface->ifa_name, strlen(interface->ifa_name) }));
+    }
+    return {};
+}
+
+// A connection is stranded once its address is gone, or once the way to its peer leaves by another interface than the
+// one its address is on: a VPN that came up takes the traffic of connections opened before it, and one that went down
+// takes its address with it. A new address on the same interface, as IPv6 privacy addresses come and go, strands
+// nothing.
+static bool is_stranded(int fd, ifaddrs const* interfaces)
+{
+    sockaddr_storage local {};
+    sockaddr_storage peer {};
+    socklen_t length = sizeof(local);
+    if (getsockname(fd, reinterpret_cast<sockaddr*>(&local), &length) < 0 || (local.ss_family != AF_INET && local.ss_family != AF_INET6))
+        return false;
+    length = sizeof(peer);
+    if (getpeername(fd, reinterpret_cast<sockaddr*>(&peer), &length) < 0)
+        return false;
+
+    auto interface_of_connection = interface_with_address(interfaces, local);
+    if (!interface_of_connection.has_value())
+        return true;
+
+    // Connecting a datagram socket sends nothing; it asks the kernel for the route, and with it the address a new
+    // connection to the peer would come from.
+    auto probe = socket(peer.ss_family, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (probe < 0)
+        return false;
+    sockaddr_storage source {};
+    length = sizeof(source);
+    bool has_route = connect(probe, reinterpret_cast<sockaddr*>(&peer), peer.ss_family == AF_INET ? sizeof(sockaddr_in) : sizeof(sockaddr_in6)) == 0
+        && getsockname(probe, reinterpret_cast<sockaddr*>(&source), &length) == 0;
+    close(probe);
+    if (!has_route)
+        return true;
+    if (same_address(source, local))
+        return false;
+    return interface_with_address(interfaces, source) != interface_of_connection;
+}
+
+static void close_stranded_connections()
+{
+    ifaddrs* interfaces = nullptr;
+    if (getifaddrs(&interfaces) < 0)
+        return;
+    size_t closed = 0;
+    for (auto fd : sockets_of_curl()) {
+        if (!is_stranded(fd, interfaces))
+            continue;
+        // libcurl owns the socket and closes it: shutting it down wakes whatever waits on it, and libcurl finds it at
+        // its end, as it does a cached connection it would reuse.
+        shutdown(fd, SHUT_RDWR);
+        ++closed;
+    }
+    freeifaddrs(interfaces);
+    if (closed > 0)
+        dbgln("RequestServer: the network changed; closed {} stranded connection(s)", closed);
+}
+
+void watch_for_network_changes()
+{
+    auto fd = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC | SOCK_NONBLOCK, NETLINK_ROUTE);
+    if (fd < 0) {
+        dbgln("RequestServer: cannot watch for network changes: {}", strerror(errno));
+        return;
+    }
+    sockaddr_nl address {};
+    address.nl_family = AF_NETLINK;
+    // A VPN may change only the routing rules, as WireGuard's does, so those are listened to as well.
+    address.nl_groups = RTMGRP_LINK | RTMGRP_IPV4_IFADDR | RTMGRP_IPV6_IFADDR | RTMGRP_IPV4_ROUTE | RTMGRP_IPV6_ROUTE
+        | (1u << (RTNLGRP_IPV4_RULE - 1)) | (1u << (RTNLGRP_IPV6_RULE - 1));
+    if (bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) < 0) {
+        dbgln("RequestServer: cannot watch for network changes: {}", strerror(errno));
+        close(fd);
+        return;
+    }
+
+    // A change comes as a burst of messages; the connections are looked at once it has settled. The timer and the
+    // notifier live as long as the process, and are left to its exit rather than destroyed after the event loop.
+    auto* settle_timer = &Core::Timer::create_single_shot(AK::Duration::from_milliseconds(300), [] {
+        close_stranded_connections();
+    }).leak_ref();
+    auto* notifier = &Core::Notifier::construct(fd, Core::NotificationType::Read).leak_ref();
+    notifier->on_activation = [fd, settle_timer] {
+        char buffer[8192];
+        while (recv(fd, buffer, sizeof(buffer), 0) > 0) { }
+        settle_timer->restart();
+    };
+}
+
+#else
+
+void watch_for_network_changes()
+{
+}
+
+#endif
+
+}
