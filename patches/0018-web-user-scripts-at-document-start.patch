+
+// NB: Every page goes through apply_content_blocking_policy when it starts hosting a tab's documents, the pages of
+//     frames from other processes included, so that is where a page gets the user scripts.
+void Application::send_user_scripts(WebContentPage& page)
+{
+    page.async_debug_request("clear-user-scripts"sv, {});
+    for (auto const& script : m_user_scripts)
+        page.async_debug_request("add-user-script"sv, script);
+}
+
+void Application::set_user_scripts(Vector<ByteString> scripts)
+{
+    m_user_scripts = move(scripts);
+    WebContentClient::for_each_client([&](WebContentClient& client) {
+        client.for_each_page([&](WebContentPage& page) {
+            send_user_scripts(page);
+            return IterationDecision::Continue;
+        });
+        return IterationDecision::Continue;
+    });
 }
 
