+// AD-HOC: An embedder's user scripts (Page::user_scripts) run as the document may first run scripts, before its
+//         parser starts, so before any script of the document's own: "document start", as other engines name it.
+void Document::run_user_scripts()
+{
+    if (!url().scheme().is_one_of("http"sv, "https"sv))
+        return;
+    auto& user_scripts = page().user_scripts();
+    if (user_scripts.is_empty())
+        return;
+    auto& settings = relevant_settings_object();
+    if (!HTML::is_scripting_enabled(settings))
+        return;
+    for (auto const& source : user_scripts) {
+        auto script = HTML::ClassicScript::create("(user script)", source, settings, url());
+        (void)script->run();
+    }
+}
