+EventResult Page::touch_scroll_step_result(bool cancelable, double delta_x, double delta_y)
+{
+    // https://w3c.github.io/pointerevents/#the-touch-action-css-property
+    // NB: As in other browsers, the direction the finger first scrolls in decides whether touch-action lets it pan.
+    if (!m_touch_scroll_direction_decided && (delta_x != 0 || delta_y != 0)) {
+        m_touch_scroll_direction_decided = true;
+        auto magnitude = [](double delta) { return delta < 0 ? -delta : delta; };
+        if (!(magnitude(delta_x) > magnitude(delta_y) ? m_touch_pans_x : m_touch_pans_y))
+            m_touch_prevents_scrolling = true;
+    }
+    // NB: A step the compositor scrolled already cannot be taken back.
+    if (m_touch_prevents_scrolling && cancelable)
+        return EventResult::Cancelled;
+    m_touch_scrolls = true;
+    return EventResult::Accepted;
+}
