+// https://w3c.github.io/pointerevents/#determining-supported-direct-manipulation-behavior
+// Whether touch-action keeps a finger on the element from panning both ways (Iroise, patches/0021).
+static bool touch_action_restricts_panning(Element const& element)
+{
+    auto style = element.computed_style();
+    if (!style)
+        return false;
+    auto value = style->computed_style_value(CSS::PropertyID::TouchAction);
+    if (!value || value->to_keyword() == CSS::Keyword::Auto || value->to_keyword() == CSS::Keyword::Manipulation)
+        return false;
+    auto text = value->to_string(CSS::SerializationMode::Normal);
+    bool pans_x = text.contains("pan-x"sv) || text.contains("pan-left"sv) || text.contains("pan-right"sv);
+    bool pans_y = text.contains("pan-y"sv) || text.contains("pan-up"sv) || text.contains("pan-down"sv);
+    return !(pans_x && pans_y);
+}
+
+// NB: The compositor scrolls a finger without the page, except where touch-action may keep the finger: there, as over
+//     a blocking touch listener, it leaves the finger's first step to the page.
+void Element::update_restricts_touch_panning()
+{
+    bool restricts = touch_action_restricts_panning(*this);
+    if (restricts == restricts_touch_panning())
+        return;
+    set_restricts_touch_panning(restricts);
+    auto& document = this->document();
+    if (restricts)
+        document.set_may_have_blocking_wheel_event_listener();
+    update_inside_blocking_wheel_event_handler_state_for_subtree();
+    set_needs_repaint();
+    document.set_needs_to_record_display_list();
+    document.page().invalidate_compositor_wheel_event_listener_state(document);
+}
