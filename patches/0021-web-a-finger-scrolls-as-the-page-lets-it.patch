+// https://w3c.github.io/pointerevents/#determining-supported-direct-manipulation-behavior
+// The directions a touch may pan in: what touch-action allows on the element it began on and on every element around
+// it (Iroise, patches/0021). NB: Other browsers stop at the nearest scroll container; this goes to the root.
+static void touch_panning_for(DOM::Node& target, bool& pans_x, bool& pans_y)
+{
+    pans_x = pans_y = true;
+    for (GC::Ptr<DOM::Node> node = target; node && (pans_x || pans_y); node = node->flat_tree_parent()) {
+        auto* element = as_if<DOM::Element>(*node);
+        if (!element)
+            continue;
+        DOM::AbstractElement abstract_element { *element };
+        RefPtr<CSS::StyleValue const> value;
+        if (auto computed = CSS::CSSStyleProperties::resolved_value_read_from_computed_style(abstract_element, CSS::PropertyID::TouchAction); computed.has_value())
+            value = computed.release_value();
+        else if (auto property = CSS::CSSStyleProperties::create_resolved_style(abstract_element)->get_property(CSS::PropertyID::TouchAction); property.has_value())
+            value = property->value;
+        if (!value)
+            continue;
+        auto text = value->to_string(CSS::SerializationMode::Normal);
+        if (text == "auto"sv)
+            continue;
+        bool manipulation = text == "manipulation"sv;
+        pans_x = pans_x && (manipulation || text.contains("pan-x"sv) || text.contains("pan-left"sv) || text.contains("pan-right"sv));
+        pans_y = pans_y && (manipulation || text.contains("pan-y"sv) || text.contains("pan-up"sv) || text.contains("pan-down"sv));
+    }
+}
