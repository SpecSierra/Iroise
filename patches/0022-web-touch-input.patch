+// Pacific: touch events, until Ladybird has its own (patches/0022, docs/TOUCH.md in Pacific).
+// https://w3c.github.io/touch-events/
+EventResult EventHandler::handle_touch(Web::MouseEvent::Type type, CSSPixelPoint visual_viewport_position, CSSPixelPoint screen_position, unsigned modifiers, Optional<RemoteInputEventTarget>* remote_target)
+{
+    using enum Web::MouseEvent::Type;
+
+    if (should_ignore_device_input_event())
+        return EventResult::Dropped;
+    auto document = m_navigable->active_document();
+    if (!document || !document->is_fully_active())
+        return EventResult::Dropped;
+
+    // The rest of a touch goes where its touchstart went, also when the finger has left that element or frame.
+    if (type != TouchStart) {
+        auto touch = m_touch;
+        // NB: Only once the event is dispatched, which reads the touch.
+        ScopeGuard forget_ended_touch = [&] {
+            if (type == TouchEnd || type == TouchCancel)
+                m_touch = {};
+        };
+        if (auto nested_navigable = touch.nested_navigable.ptr()) {
+            auto& event_handler = nested_navigable->event_handler();
+            event_handler.set_handling_input_event_id(handling_input_event_id());
+            ScopeGuard end_input = [&] { event_handler.set_handling_input_event_id(0); };
+            return event_handler.handle_touch(type, visual_viewport_position.translated(touch.nested_offset), screen_position, modifiers, remote_target);
+        }
+        if (touch.remote_navigable_id.has_value()) {
+            if (!remote_target)
+                return EventResult::Dropped;
+            *remote_target = RemoteInputEventTarget { *touch.remote_navigable_id, visual_viewport_position.translated(touch.nested_offset) };
+            return EventResult::Handled;
+        }
+        if (!touch.target)
+            return EventResult::Dropped;
+        return dispatch_touch_event(type, visual_viewport_position, screen_position, modifiers);
+    }
+
+    m_touch = {};
+
+    Layout::ForcedReadScope read { *document };
+    document->update_layout(DOM::UpdateLayoutReason::EventHandlerHandleMouseDown);
+    if (!has_committed_root_box())
+        return EventResult::Dropped;
+
+    auto target = target_for_mouse_position(visual_viewport_position);
+    if (!target.has_value())
+        return EventResult::Dropped;
+    auto* target_layout_node = target->layout_node(read);
+    GC::Ptr<DOM::Node> node = target->dom_node();
+    if (!target_layout_node || !node)
+        return EventResult::Dropped;
+
+    // A touch on the content of a nested navigable is that navigable's, to the end.
+    GC::Ptr<HTML::LocalNavigable> nested_navigable;
+    CSSPixelPoint nested_position;
+    Optional<RemoteInputEventTarget> nested_remote_target;
+    auto nested_result = dispatch_event_to_nested_navigable(*this, *target_layout_node, node, visual_viewport_position, &nested_remote_target, [&](EventHandler& event_handler, CSSPixelPoint position) {
+        nested_navigable = event_handler.m_navigable;
+        nested_position = position;
+        return event_handler.handle_touch(type, position, screen_position, modifiers, remote_target);
+    });
+    if (nested_result.has_value()) {
+        if (nested_navigable) {
+            m_touch.nested_navigable = nested_navigable;
+            m_touch.nested_offset = nested_position - visual_viewport_position;
+        } else if (nested_remote_target.has_value()) {
+            if (!remote_target)
+                return EventResult::Dropped;
+            m_touch.remote_navigable_id = nested_remote_target->navigable_id;
+            m_touch.nested_offset = nested_remote_target->position - visual_viewport_position;
+            *remote_target = *nested_remote_target;
+        }
+        return *nested_result;
+    }
+
+    // The target is the element the touch began on.
+    Layout::Node* layout_node = nullptr;
+    if (!parent_element_for_event_dispatch(*target_layout_node, node, layout_node))
+        return EventResult::Dropped;
+    m_touch.target = node;
+    m_touch.identifier = m_next_touch_identifier++;
+    return dispatch_touch_event(type, visual_viewport_position, screen_position, modifiers);
+}
+
+static bool has_touch_event_listener(DOM::EventTarget const& target)
+{
+    return target.has_event_listener(UIEvents::EventNames::touchstart) || target.has_event_listener(UIEvents::EventNames::touchmove)
+        || target.has_event_listener(UIEvents::EventNames::touchend) || target.has_event_listener(UIEvents::EventNames::touchcancel);
+}
+
+EventResult EventHandler::dispatch_touch_event(Web::MouseEvent::Type type, CSSPixelPoint visual_viewport_position, CSSPixelPoint screen_position, unsigned modifiers)
+{
+    using enum Web::MouseEvent::Type;
+
+    auto document = m_navigable->active_document();
+    GC::Ptr<DOM::Node> target = m_touch.target.ptr();
+    if (!document || !target)
+        return EventResult::Dropped;
+    auto& page = m_navigable->page();
+
+    auto event_name = [&]() -> Utf16FlyString const& {
+        switch (type) {
+        case TouchStart:
+            return UIEvents::EventNames::touchstart;
+        case TouchMove:
+            return UIEvents::EventNames::touchmove;
+        case TouchEnd:
+            return UIEvents::EventNames::touchend;
+        default:
+            return UIEvents::EventNames::touchcancel;
+        }
+    }();
+    // https://w3c.github.io/touch-events/#cancelability
+    // NB: A touchmove can no longer be cancelled once the finger scrolls, as in other browsers.
+    bool cancelable = type == TouchStart || type == TouchEnd || (type == TouchMove && !page.touch_scrolls());
+
+    auto viewport_position = document->visual_viewport()->map_to_layout_viewport(visual_viewport_position);
+    auto touch = UIEvents::Touch::create(m_touch.identifier, *target, screen_position, viewport_position, compute_mouse_event_page_offset(viewport_position), 12);
+    Vector<GC::Ref<UIEvents::Touch>> touches;
+    if (type != TouchEnd && type != TouchCancel)
+        touches.append(touch);
+    auto event = UIEvents::TouchEvent::create_from_platform_event(event_name, m_navigable->active_window_proxy(), UIEvents::TouchList::create(touches), UIEvents::TouchList::create(touches), UIEvents::TouchList::create({ touch }), modifiers, cancelable, HighResolutionTime::current_high_resolution_time(HTML::relevant_global_object(*target)));
+    bool cancelled = !target->dispatch_event(event);
+
+    // https://w3c.github.io/touch-events/#mouse-events
+    // NB: A cancelled touchstart or touchmove keeps the finger from scrolling; a cancelled touchstart or touchend keeps
+    //     the tap from becoming the mouse events of one, which the UI sends only for a touch that ends as Accepted or
+    //     Handled.
+    if (cancelled && (type == TouchStart || type == TouchMove))
+        page.touch_prevented_scrolling();
+    if (cancelled && type == TouchStart)
+        m_touch.start_cancelled = true;
+    if (cancelled || (type == TouchEnd && m_touch.start_cancelled))
+        return EventResult::Cancelled;
+
+    // Whether the page listens for touches where this one is, which a UI may want to know (to make a mouse of the finger
+    // where nothing listens, say).
+    for (GC::Ptr<DOM::Node> node = target; node; node = node->parent_or_shadow_host()) {
+        if (has_touch_event_listener(*node))
+            return EventResult::Handled;
+    }
+    if (auto window = document->window(); window && has_touch_event_listener(*window))
+        return EventResult::Handled;
+    return EventResult::Accepted;
+}
+
 }
