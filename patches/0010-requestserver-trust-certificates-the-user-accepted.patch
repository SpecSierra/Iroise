+// A host whose certificate the user chose to trust although it could not be verified: only the public key of the
+// certificate the user saw is accepted for it (curl's "sha256//<base64>" pin). Private requests keep their own.
+struct CertificateException {
+    ByteString host;
+    ByteString pinned_public_key;
+    IsPrivate is_private { IsPrivate::No };
+};
+static Vector<CertificateException> s_certificate_exceptions;
+
+void set_certificate_exceptions(Vector<ByteString> exceptions)
+{
+    s_certificate_exceptions.clear();
+    for (auto const& exception : exceptions) {
+        // "<host>\t<pin>\t" for ordinary requests, "<host>\t<pin>\tprivate" for private ones.
+        auto fields = exception.split('\t', SplitBehavior::KeepEmpty);
+        if (fields.size() != 3 || fields[0].is_empty() || !fields[1].starts_with("sha256//"sv))
+            continue;
+        s_certificate_exceptions.append({ fields[0], fields[1], fields[2] == "private"sv ? IsPrivate::Yes : IsPrivate::No });
+    }
+}
+
+static CertificateException const* find_certificate_exception(URL::URL const& url, IsPrivate is_private)
+{
+    if (url.scheme() != "https"sv)
+        return nullptr;
+    auto host = url.serialized_host().to_byte_string();
+    for (auto const& exception : s_certificate_exceptions) {
+        if (exception.host == host && exception.is_private == is_private)
+            return &exception;
+    }
+    return nullptr;
+}
