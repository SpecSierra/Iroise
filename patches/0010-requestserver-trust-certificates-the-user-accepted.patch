 // Let Fetch authorize credentials; otherwise curl sends URL credentials itself.
+static HashTable<ByteString> s_certificate_exceptions;
+
+void set_certificate_exceptions(Vector<ByteString> hosts)
+{
+    s_certificate_exceptions.clear();
+    for (auto& host : hosts)
+        s_certificate_exceptions.set(move(host));
+}
+
+static bool has_certificate_exception(URL::URL const& url)
+{
+    return url.scheme() == "https"sv && s_certificate_exceptions.contains(url.serialized_host().to_byte_string());
+}
