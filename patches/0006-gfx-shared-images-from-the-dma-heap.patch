@@ -96,8 +111,145 @@ int VulkanImage::get_dma_buf_fd() const
     return fd;
 }
 
+#    ifdef LADYBIRD_SHARED_IMAGES_FROM_DMA_HEAP
+// Android GPU drivers reached through libhybris import dma-bufs but do not export the memory they allocate
+// themselves: vkGetMemoryFdKHR reports success and hands back no file descriptor. So allocate the buffer from the
+// kernel's dma-heap and import it, which gives the same kind of shared image from the other direction.
+static ErrorOr<NonnullRefPtr<VulkanImage>> create_shared_vulkan_image_from_dma_heap(VulkanContext const& context, uint32_t width, uint32_t height, VkFormat format)
+{
+    static constexpr VkDeviceSize row_alignment = 64;
+    VkDeviceSize const row_pitch = (static_cast<VkDeviceSize>(width) * 4 + row_alignment - 1) & ~(row_alignment - 1);
+    VkDeviceSize const page_size = static_cast<VkDeviceSize>(sysconf(_SC_PAGESIZE));
+    VkDeviceSize const buffer_size = (row_pitch * height + page_size - 1) & ~(page_size - 1);
+
+    int heap_fd = ::open("/dev/dma_heap/system", O_RDONLY | O_CLOEXEC);
+    if (heap_fd < 0)
+        return Error::from_syscall("open(/dev/dma_heap/system)"sv, errno);
+    dma_heap_allocation_data allocation {};
+    allocation.len = buffer_size;
+    allocation.fd_flags = O_RDWR | O_CLOEXEC;
+    int rc = ::ioctl(heap_fd, DMA_HEAP_IOCTL_ALLOC, &allocation);
+    auto allocation_errno = errno;
+    ::close(heap_fd);
+    if (rc < 0)
+        return Error::from_syscall("ioctl(DMA_HEAP_IOCTL_ALLOC)"sv, allocation_errno);
+
+    NonnullRefPtr<VulkanImage> image = make_ref_counted<VulkanImage>(context);
+    image->imported_dma_buf_fd = static_cast<int>(allocation.fd);
+
+    VkSubresourceLayout plane_layout {};
+    plane_layout.offset = 0;
+    plane_layout.rowPitch = row_pitch;
+    VkImageDrmFormatModifierExplicitCreateInfoEXT modifier_info = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_DRM_FORMAT_MODIFIER_EXPLICIT_CREATE_INFO_EXT,
+        .pNext = nullptr,
+        .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
+        .drmFormatModifierPlaneCount = 1,
+        .pPlaneLayouts = &plane_layout,
+    };
+    VkExternalMemoryImageCreateInfo external_mem_image_info = {
+        .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO,
+        .pNext = &modifier_info,
+        .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+    };
+    VkImageCreateInfo image_info = {
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .pNext = &external_mem_image_info,
+        .flags = 0,
+        .imageType = VK_IMAGE_TYPE_2D,
+        .format = format,
+        .extent = { .width = width, .height = height, .depth = 1 },
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT,
+        .tiling = VK_IMAGE_TILING_DRM_FORMAT_MODIFIER_EXT,
+        .usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+        .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+        .queueFamilyIndexCount = 0,
+        .pQueueFamilyIndices = nullptr,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    if (auto result = vkCreateImage(context.logical_device, &image_info, nullptr, &image->image); result != VK_SUCCESS) {
+        dbgln("vkCreateImage returned {}", to_underlying(result));
+        return Error::from_string_literal("image creation failed");
+    }
+
+    VkMemoryRequirements mem_reqs;
+    vkGetImageMemoryRequirements(context.logical_device, image->image, &mem_reqs);
+
+    auto get_memory_fd_properties = reinterpret_cast<PFN_vkGetMemoryFdPropertiesKHR>(vkGetDeviceProcAddr(context.logical_device, "vkGetMemoryFdPropertiesKHR"));
+    if (!get_memory_fd_properties)
+        return Error::from_string_literal("vkGetMemoryFdPropertiesKHR is not available");
+    VkMemoryFdPropertiesKHR fd_properties = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_FD_PROPERTIES_KHR,
+        .pNext = nullptr,
+        .memoryTypeBits = 0,
+    };
+    if (get_memory_fd_properties(context.logical_device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT, image->imported_dma_buf_fd, &fd_properties) != VK_SUCCESS)
+        return Error::from_string_literal("the driver rejected the dma-heap buffer");
+
+    uint32_t const usable_types = mem_reqs.memoryTypeBits & fd_properties.memoryTypeBits;
+    if (usable_types == 0 || mem_reqs.size > buffer_size)
+        return Error::from_string_literal("the dma-heap buffer does not fit the image");
+    uint32_t const mem_type_idx = static_cast<uint32_t>(__builtin_ctz(usable_types));
+
+    // NB: A successful import takes ownership of the file descriptor, so give the driver a duplicate.
+    int import_fd = fcntl(image->imported_dma_buf_fd, F_DUPFD_CLOEXEC, 0);
+    if (import_fd < 0)
+        return Error::from_syscall("fcntl(F_DUPFD_CLOEXEC)"sv, errno);
+    VkMemoryDedicatedAllocateInfo mem_dedicated_alloc_info = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+        .pNext = nullptr,
+        .image = image->image,
+        .buffer = VK_NULL_HANDLE,
+    };
+    VkImportMemoryFdInfoKHR import_info = {
+        .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+        .pNext = &mem_dedicated_alloc_info,
+        .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+        .fd = import_fd,
+    };
+    VkMemoryAllocateInfo mem_alloc_info = {
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .pNext = &import_info,
+        .allocationSize = buffer_size,
+        .memoryTypeIndex = mem_type_idx,
+    };
+    if (auto result = vkAllocateMemory(context.logical_device, &mem_alloc_info, nullptr, &image->memory); result != VK_SUCCESS) {
+        ::close(import_fd);
+        dbgln("vkAllocateMemory returned {}", to_underlying(result));
+        return Error::from_string_literal("importing the dma-heap buffer failed");
+    }
+    if (auto result = vkBindImageMemory(context.logical_device, image->image, image->memory, 0); result != VK_SUCCESS) {
+        dbgln("vkBindImageMemory returned {}", to_underlying(result));
+        return Error::from_string_literal("bind image memory failed");
+    }
+
+    // external APIs require general layout
+    VkImageLayout layout = VK_IMAGE_LAYOUT_GENERAL;
+    image->transition_layout(VK_IMAGE_LAYOUT_UNDEFINED, layout);
+
+    image->info = {
+        .format = image_info.format,
+        .extent = image_info.extent,
+        .tiling = image_info.tiling,
+        .usage = image_info.usage,
+        .sharing_mode = image_info.sharingMode,
+        .layout = layout,
+        .row_pitch = row_pitch,
+        .modifier = DRM_FORMAT_MOD_LINEAR,
+    };
+    return image;
+}
+#    endif
+
 ErrorOr<NonnullRefPtr<VulkanImage>> create_shared_vulkan_image(VulkanContext const& context, uint32_t width, uint32_t height, VkFormat format, ReadonlySpan<uint64_t> modifiers)
 {
+#    ifdef LADYBIRD_SHARED_IMAGES_FROM_DMA_HEAP
+    if (modifiers.contains_slow(DRM_FORMAT_MOD_LINEAR))
+        return create_shared_vulkan_image_from_dma_heap(context, width, height, format);
+#    endif
+
     VkDrmFormatModifierPropertiesListEXT format_mod_props_list = {};
     format_mod_props_list.sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT;
     format_mod_props_list.pNext = nullptr;
