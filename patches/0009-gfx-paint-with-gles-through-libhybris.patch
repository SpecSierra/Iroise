+/*
+ * Iroise: the Sailfish OS front end for the Ladybird engine.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/AtomicRefCounted.h>
+#include <AK/Error.h>
+#include <AK/NonnullRefPtr.h>
+#include <LibGfx/SharedImage.h>
+#include <LibGfx/Size.h>
+
+namespace Gfx {
+
+// GPU painting through the system's EGL and GLES (libhybris on Sailfish OS). Both libraries are loaded privately:
+// the Compositor also carries ANGLE for WebGL, which exports the same symbol names. Callers never see EGL or GL types.
+class GLESContext : public AtomicRefCounted<GLESContext> {
+public:
+    static ErrorOr<NonnullRefPtr<GLESContext>> create();
+    ~GLESContext();
+
+    void make_current() const;
+    // Any EGL or GL entry point, for Skia's GL interface.
+    void* get_proc_address(char const* name) const;
+
+    void* display() const { return m_display; }
+
+private:
+    GLESContext() = default;
+
+    void* m_display { nullptr };
+    void* m_context { nullptr };
+    void* m_surface { nullptr };
+};
+
+// An image painted by GL and shown by another process: a gralloc buffer, allocated through libhybris, rendered to as
+// a texture behind a framebuffer. Its pixels are shared as a dma-buf with plain BGRA rows.
+struct GLESImage : public AtomicRefCounted<GLESImage> {
+    static ErrorOr<NonnullRefPtr<GLESImage>> create(GLESContext&, IntSize);
+    ~GLESImage();
+
+    NonnullRefPtr<GLESContext> context;
+    IntSize size;
+    size_t pitch { 0 };
+    int dmabuf_fd { -1 };
+    u64 identity { 0 };
+    void* native_buffer { nullptr };
+    void* egl_image { nullptr };
+    u32 texture { 0 };
+    u32 stencil { 0 };
+    u32 framebuffer { 0 };
+
+private:
+    explicit GLESImage(NonnullRefPtr<GLESContext>);
+};
+
+LinuxDmaBufHandle duplicate_linux_dmabuf_handle(GLESImage const&);
+SharedImage duplicate_shared_image(GLESImage const&);
+
+}
