+NonnullRefPtr<PaintingSurface> PaintingSurface::create_from_gles_image(NonnullRefPtr<SkiaBackendContext> context, NonnullRefPtr<GLESImage> image, Origin origin)
+{
+    // NB: GL sees the BGRA gralloc buffer as an RGBA texture; the driver keeps the bytes in BGRA order in memory.
+    static constexpr GrGLenum gl_rgba8 = 0x8058;
+    GrGLFramebufferInfo framebuffer_info {};
+    framebuffer_info.fFBOID = image->framebuffer;
+    framebuffer_info.fFormat = gl_rgba8;
+    auto render_target = GrBackendRenderTargets::MakeGL(image->size.width(), image->size.height(), 0, 8, framebuffer_info);
+
+    auto size = image->size;
+    // Skia holds a reference to the image until it lets go of the surface.
+    image->ref();
+    auto surface = SkSurfaces::WrapBackendRenderTarget(context->sk_context(), render_target, origin_to_sk_origin(origin), kRGBA_8888_SkColorType,
+        SkColorSpace::MakeSRGB(), nullptr, [](void* image) { static_cast<GLESImage*>(image)->unref(); }, image.ptr());
+    VERIFY(surface);
+    return adopt_ref(*new PaintingSurface(make<Impl>(context, size, surface, nullptr, true)));
+}
+#endif
