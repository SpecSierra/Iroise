diff --git a/Libraries/LibGfx/GLESContext.cpp b/Libraries/LibGfx/GLESContext.cpp
new file mode 100644
index 000000000..9e4727107
--- /dev/null
+++ b/Libraries/LibGfx/GLESContext.cpp
@@ -0,0 +1,357 @@
+/*
+ * Iroise: the Sailfish OS front end for the Ladybird engine.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/Format.h>
+#include <AK/Vector.h>
+#include <LibGfx/GLESContext.h>
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GLES2/gl2.h>
+#include <GLES2/gl2ext.h>
+#include <dlfcn.h>
+#include <libdrm/drm_fourcc.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <AK/Atomic.h>
+
+namespace Gfx {
+
+// libhybris' extension for Android buffers, and Android's names for what we ask gralloc for.
+static constexpr EGLenum egl_native_buffer_hybris = 0x3140;
+static constexpr EGLint android_pixel_format_bgra_8888 = 5;
+// NB: The software read and write bits make the Mali gralloc lay the buffer out as plain rows rather than AFBC, which
+//     is what lets other processes read it as an ordinary BGRA dma-buf.
+// NB: Software read/write keeps the buffer in plain rows (no AFBC or UBWC compression). "Rarely": for "often" Qualcomm's
+//     gralloc hands out CPU-cached memory, and frames rendered by the GPU get lost behind stale cache lines.
+static constexpr EGLint gralloc_usage = 0x22 /* software read/write rarely */ | 0x100 /* texture */ | 0x200 /* render target */;
+
+namespace {
+
+struct Functions {
+#define ENUMERATE_EGL_FUNCTIONS(X)  \
+    X(eglGetDisplay)                \
+    X(eglInitialize)                \
+    X(eglTerminate)                 \
+    X(eglBindAPI)                   \
+    X(eglChooseConfig)              \
+    X(eglCreateContext)             \
+    X(eglDestroyContext)            \
+    X(eglCreatePbufferSurface)      \
+    X(eglDestroySurface)            \
+    X(eglMakeCurrent)               \
+    X(eglGetError)                  \
+    X(eglQueryString)               \
+    X(eglGetProcAddress)
+#define ENUMERATE_GL_FUNCTIONS(X)   \
+    X(glGenTextures)                \
+    X(glDeleteTextures)             \
+    X(glBindTexture)                \
+    X(glTexParameteri)              \
+    X(glGenFramebuffers)            \
+    X(glDeleteFramebuffers)         \
+    X(glBindFramebuffer)            \
+    X(glFramebufferTexture2D)       \
+    X(glGenRenderbuffers)           \
+    X(glDeleteRenderbuffers)        \
+    X(glBindRenderbuffer)           \
+    X(glRenderbufferStorage)        \
+    X(glFramebufferRenderbuffer)    \
+    X(glCheckFramebufferStatus)
+#define DECLARE(name) decltype(&::name) name { nullptr };
+    ENUMERATE_EGL_FUNCTIONS(DECLARE)
+    ENUMERATE_GL_FUNCTIONS(DECLARE)
+#undef DECLARE
+
+    using CreateNativeBuffer = EGLBoolean (*)(EGLint width, EGLint height, EGLint usage, EGLint format, EGLint* stride, EGLClientBuffer*);
+    using GetNativeBufferInfo = void (*)(EGLClientBuffer, int* int_count, int* fd_count);
+    using SerializeNativeBuffer = void (*)(EGLClientBuffer, int* ints, int* fds);
+    using ReleaseNativeBuffer = EGLBoolean (*)(EGLClientBuffer);
+    CreateNativeBuffer create_native_buffer { nullptr };
+    GetNativeBufferInfo get_native_buffer_info { nullptr };
+    SerializeNativeBuffer serialize_native_buffer { nullptr };
+    ReleaseNativeBuffer release_native_buffer { nullptr };
+    PFNEGLCREATEIMAGEKHRPROC create_image { nullptr };
+    PFNEGLDESTROYIMAGEKHRPROC destroy_image { nullptr };
+    PFNGLEGLIMAGETARGETTEXTURE2DOESPROC image_target_texture { nullptr };
+
+    void* egl_library { nullptr };
+    void* gles_library { nullptr };
+};
+
+Functions* load_functions()
+{
+    static Functions functions;
+    static bool loaded = [] {
+        // NB: RTLD_DEEPBIND makes the libraries resolve their own symbols first, not ANGLE's of the same name.
+        int flags = RTLD_NOW | RTLD_LOCAL | RTLD_DEEPBIND;
+        functions.egl_library = dlopen("libEGL.so.1", flags);
+        functions.gles_library = dlopen("libGLESv2.so.2", flags);
+        if (!functions.egl_library || !functions.gles_library) {
+            dbgln("GLES: cannot load the system's EGL or GLES: {}", dlerror());
+            return false;
+        }
+#define LOAD(name, library) functions.name = reinterpret_cast<decltype(functions.name)>(dlsym(functions.library, #name));
+#define LOAD_EGL(name) LOAD(name, egl_library)
+#define LOAD_GL(name) LOAD(name, gles_library)
+        ENUMERATE_EGL_FUNCTIONS(LOAD_EGL)
+        ENUMERATE_GL_FUNCTIONS(LOAD_GL)
+#undef LOAD_GL
+#undef LOAD_EGL
+#undef LOAD
+#define CHECK(name)                                    \
+    if (!functions.name) {                             \
+        dbgln("GLES: the system has no {}", #name);    \
+        return false;                                  \
+    }
+        ENUMERATE_EGL_FUNCTIONS(CHECK)
+        ENUMERATE_GL_FUNCTIONS(CHECK)
+#undef CHECK
+        return true;
+    }();
+    return loaded ? &functions : nullptr;
+}
+
+// NB: libhybris only hands out its extensions once a display is initialized.
+bool resolve_extensions()
+{
+    static bool resolved = [] {
+        auto& functions = *load_functions();
+        auto extension = [&](char const* name) { return functions.eglGetProcAddress(name); };
+        functions.create_native_buffer = reinterpret_cast<Functions::CreateNativeBuffer>(extension("eglHybrisCreateNativeBuffer"));
+        functions.get_native_buffer_info = reinterpret_cast<Functions::GetNativeBufferInfo>(extension("eglHybrisGetNativeBufferInfo"));
+        functions.serialize_native_buffer = reinterpret_cast<Functions::SerializeNativeBuffer>(extension("eglHybrisSerializeNativeBuffer"));
+        functions.release_native_buffer = reinterpret_cast<Functions::ReleaseNativeBuffer>(extension("eglHybrisReleaseNativeBuffer"));
+        functions.create_image = reinterpret_cast<PFNEGLCREATEIMAGEKHRPROC>(extension("eglCreateImageKHR"));
+        functions.destroy_image = reinterpret_cast<PFNEGLDESTROYIMAGEKHRPROC>(extension("eglDestroyImageKHR"));
+        functions.image_target_texture = reinterpret_cast<PFNGLEGLIMAGETARGETTEXTURE2DOESPROC>(extension("glEGLImageTargetTexture2DOES"));
+#define CHECK(name)                                    \
+    if (!functions.name) {                             \
+        dbgln("GLES: the system has no {}", #name);    \
+        return false;                                  \
+    }
+        CHECK(create_native_buffer)
+        CHECK(get_native_buffer_info)
+        CHECK(serialize_native_buffer)
+        CHECK(release_native_buffer)
+        CHECK(create_image)
+        CHECK(destroy_image)
+        CHECK(image_target_texture)
+#undef CHECK
+        return true;
+    }();
+    return resolved;
+}
+
+Functions const& gl()
+{
+    auto const* functions = load_functions();
+    VERIFY(functions);
+    return *functions;
+}
+
+bool is_dmabuf(int fd)
+{
+    char path[64];
+    char target[64];
+    snprintf(path, sizeof(path), "/proc/self/fd/%d", fd);
+    auto length = readlink(path, target, sizeof(target) - 1);
+    if (length < 0)
+        return false;
+    target[length] = 0;
+    return !strncmp(target, "/dmabuf:", 8) || !strncmp(target, "anon_inode:dmabuf", 17);
+}
+
+}
+
+ErrorOr<NonnullRefPtr<GLESContext>> GLESContext::create()
+{
+    // NB: The Compositor has no window. Without this, libhybris would look for a Wayland display to attach to.
+    setenv("EGL_PLATFORM", "null", 0);
+
+    auto const* functions = load_functions();
+    if (!functions)
+        return Error::from_string_literal("No usable system EGL and GLES");
+    auto const& f = *functions;
+
+    auto context = adopt_ref(*new GLESContext);
+    auto display = f.eglGetDisplay(EGL_DEFAULT_DISPLAY);
+    if (display == EGL_NO_DISPLAY || !f.eglInitialize(display, nullptr, nullptr))
+        return Error::from_string_literal("eglInitialize failed");
+    context->m_display = display;
+    if (!resolve_extensions())
+        return Error::from_string_literal("The system's EGL cannot share gralloc buffers");
+
+    if (!f.eglBindAPI(EGL_OPENGL_ES_API))
+        return Error::from_string_literal("eglBindAPI failed");
+
+    static constexpr EGLint config_attributes[] = {
+        EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+        EGL_RENDERABLE_TYPE, EGL_OPENGL_ES2_BIT,
+        EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8, EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8,
+        EGL_NONE
+    };
+    EGLConfig config {};
+    EGLint config_count = 0;
+    if (!f.eglChooseConfig(display, config_attributes, &config, 1, &config_count) || config_count < 1)
+        return Error::from_string_literal("No EGL config for a GLES pbuffer");
+
+    static constexpr EGLint context_attributes[] = { EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE };
+    auto egl_context = f.eglCreateContext(display, config, EGL_NO_CONTEXT, context_attributes);
+    if (egl_context == EGL_NO_CONTEXT)
+        return Error::from_string_literal("eglCreateContext failed");
+    context->m_context = egl_context;
+
+    // NB: Everything we draw goes to framebuffers of our own; the context only needs some surface to be current with.
+    static constexpr EGLint surface_attributes[] = { EGL_WIDTH, 1, EGL_HEIGHT, 1, EGL_NONE };
+    auto surface = f.eglCreatePbufferSurface(display, config, surface_attributes);
+    if (surface == EGL_NO_SURFACE)
+        return Error::from_string_literal("eglCreatePbufferSurface failed");
+    context->m_surface = surface;
+
+    context->make_current();
+    return context;
+}
+
+GLESContext::~GLESContext()
+{
+    auto const& f = gl();
+    if (m_display) {
+        f.eglMakeCurrent(m_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        if (m_surface)
+            f.eglDestroySurface(m_display, m_surface);
+        if (m_context)
+            f.eglDestroyContext(m_display, m_context);
+    }
+}
+
+void GLESContext::make_current() const
+{
+    VERIFY(gl().eglMakeCurrent(m_display, m_surface, m_surface, m_context));
+}
+
+void* GLESContext::get_proc_address(char const* name) const
+{
+    auto const& f = gl();
+    if (auto* function = dlsym(f.gles_library, name))
+        return function;
+    if (auto* function = dlsym(f.egl_library, name))
+        return function;
+    return reinterpret_cast<void*>(f.eglGetProcAddress(name));
+}
+
+GLESImage::GLESImage(NonnullRefPtr<GLESContext> context)
+    : context(move(context))
+{
+}
+
+ErrorOr<NonnullRefPtr<GLESImage>> GLESImage::create(GLESContext& context, IntSize size)
+{
+    auto const& f = gl();
+    auto image = adopt_ref(*new GLESImage(context));
+    image->size = size;
+    // Unique across the processes that hand buffers on: the process id above a count of this process's buffers.
+    static Atomic<u32> s_buffer_count;
+    image->identity = (static_cast<u64>(getpid()) << 32) | ++s_buffer_count;
+
+    EGLint stride = 0;
+    EGLClientBuffer buffer = nullptr;
+    if (!f.create_native_buffer(size.width(), size.height(), gralloc_usage, android_pixel_format_bgra_8888, &stride, &buffer) || !buffer)
+        return Error::from_string_literal("gralloc could not allocate a buffer");
+    image->native_buffer = buffer;
+    image->pitch = static_cast<size_t>(stride) * 4;
+
+    // The buffer's handle carries gralloc's own descriptors besides the pixels. The pixels are a dma-buf, the largest one:
+    // Qualcomm's gralloc keeps its metadata in a small dma-buf of its own.
+    int int_count = 0;
+    int fd_count = 0;
+    f.get_native_buffer_info(buffer, &int_count, &fd_count);
+    Vector<int> ints;
+    Vector<int> fds;
+    TRY(ints.try_resize(int_count));
+    TRY(fds.try_resize(fd_count));
+    f.serialize_native_buffer(buffer, ints.data(), fds.data());
+    off_t pixels_size = -1;
+    for (auto fd : fds) {
+        if (!is_dmabuf(fd))
+            continue;
+        auto fd_size = lseek(fd, 0, SEEK_END);
+        if (fd_size > pixels_size) {
+            pixels_size = fd_size;
+            image->dmabuf_fd = fd;
+        }
+    }
+    if (image->dmabuf_fd < 0)
+        return Error::from_string_literal("gralloc buffer has no dma-buf");
+
+    context.make_current();
+    image->egl_image = f.create_image(context.display(), EGL_NO_CONTEXT, egl_native_buffer_hybris, buffer, nullptr);
+    if (image->egl_image == EGL_NO_IMAGE_KHR) {
+        image->egl_image = nullptr;
+        return Error::from_string_literal("eglCreateImage failed for a gralloc buffer");
+    }
+
+    f.glGenTextures(1, &image->texture);
+    f.glBindTexture(GL_TEXTURE_2D, image->texture);
+    f.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    f.glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    f.image_target_texture(GL_TEXTURE_2D, image->egl_image);
+
+    // Skia draws paths with the stencil buffer when there is one.
+    f.glGenRenderbuffers(1, &image->stencil);
+    f.glBindRenderbuffer(GL_RENDERBUFFER, image->stencil);
+    f.glRenderbufferStorage(GL_RENDERBUFFER, GL_STENCIL_INDEX8, size.width(), size.height());
+
+    f.glGenFramebuffers(1, &image->framebuffer);
+    f.glBindFramebuffer(GL_FRAMEBUFFER, image->framebuffer);
+    f.glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image->texture, 0);
+    f.glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_STENCIL_ATTACHMENT, GL_RENDERBUFFER, image->stencil);
+    auto status = f.glCheckFramebufferStatus(GL_FRAMEBUFFER);
+    f.glBindFramebuffer(GL_FRAMEBUFFER, 0);
+    if (status != GL_FRAMEBUFFER_COMPLETE)
+        return Error::from_string_literal("A gralloc buffer cannot be rendered to");
+
+    return image;
+}
+
+GLESImage::~GLESImage()
+{
+    auto const& f = gl();
+    context->make_current();
+    if (framebuffer)
+        f.glDeleteFramebuffers(1, &framebuffer);
+    if (stencil)
+        f.glDeleteRenderbuffers(1, &stencil);
+    if (texture)
+        f.glDeleteTextures(1, &texture);
+    if (egl_image)
+        f.destroy_image(context->display(), egl_image);
+    // NB: Releasing the buffer closes its descriptors, the dma-buf among them.
+    if (native_buffer)
+        f.release_native_buffer(native_buffer);
+}
+
+LinuxDmaBufHandle duplicate_linux_dmabuf_handle(GLESImage const& image)
+{
+    auto fd = dup(image.dmabuf_fd);
+    VERIFY(fd >= 0);
+    LinuxDmaBufHandle dma_buf;
+    dma_buf.size = image.size;
+    dma_buf.drm_format = DRM_FORMAT_ARGB8888;
+    dma_buf.modifier = DRM_FORMAT_MOD_LINEAR;
+    dma_buf.objects.append(IPC::File::adopt_fd(fd));
+    dma_buf.planes.append({ .object_index = 0, .offset = 0, .pitch = static_cast<u32>(image.pitch) });
+    dma_buf.identity = image.identity;
+    return dma_buf;
+}
+
+SharedImage duplicate_shared_image(GLESImage const& image)
+{
+    return SharedImage { duplicate_linux_dmabuf_handle(image) };
+}
+
+}
