+#ifdef USE_GLES_HYBRIS
+class SkiaGLESBackendContext final : public SkiaBackendContext {
+    AK_MAKE_NONCOPYABLE(SkiaGLESBackendContext);
+    AK_MAKE_NONMOVABLE(SkiaGLESBackendContext);
+
+public:
+    SkiaGLESBackendContext(sk_sp<GrDirectContext> context, NonnullRefPtr<GLESContext> gles_context)
+        : m_context(move(context))
+        , m_gles_context(move(gles_context))
+    {
+    }
+
+    ~SkiaGLESBackendContext() override
+    {
+        m_gles_context->make_current();
+        m_context.reset();
+    }
+
+    GrDirectContext* sk_context() const override { return m_context.get(); }
+
+    VulkanContext const& vulkan_context() override { VERIFY_NOT_REACHED(); }
+
+    MetalContext& metal_context() override { VERIFY_NOT_REACHED(); }
+
+    GLESContext& gles_context() override { return m_gles_context; }
+
+private:
+    sk_sp<GrDirectContext> m_context;
+    NonnullRefPtr<GLESContext> m_gles_context;
+};
+
+RefPtr<SkiaBackendContext> SkiaBackendContext::create_gles_context(NonnullRefPtr<GLESContext> gles_context)
+{
+    auto interface = GrGLMakeAssembledInterface(gles_context.ptr(), [](void* context, char const* name) -> GrGLFuncPtr {
+        return reinterpret_cast<GrGLFuncPtr>(static_cast<GLESContext*>(context)->get_proc_address(name));
+    });
+    if (!interface) {
+        dbgln("Skia could not assemble a GLES interface");
+        return {};
+    }
+
+    GrContextOptions options;
+    options.fReduceOpsTaskSplitting = GrContextOptions::Enable::kNo;
+
+    auto context = GrDirectContexts::MakeGL(move(interface), options);
+    if (!context) {
+        dbgln("Skia GLES context creation failed");
+        return {};
+    }
+    context->setResourceCacheLimit(skia_resource_cache_limit);
+    return adopt_ref(*new SkiaGLESBackendContext(move(context), move(gles_context)));
+}
+#endif
+
 }
