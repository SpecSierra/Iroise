+    options.bubbles = !is_boundary_event;
+    options.cancelable = !is_boundary_event && event_name != UIEvents::EventNames::pointercancel;
+    options.composed = !is_boundary_event;
+    options.view = view;
+    options.ctrl_key = modifiers & UIEvents::Mod_Ctrl;
+    options.shift_key = modifiers & UIEvents::Mod_Shift;
+    options.alt_key = modifiers & UIEvents::Mod_Alt;
+    options.meta_key = modifiers & UIEvents::Mod_Super;
+    options.screen_x = screen.x().to_double();
+    options.screen_y = screen.y().to_double();
