diff --git a/Libraries/LibGfx/CMakeLists.txt b/Libraries/LibGfx/CMakeLists.txt
index 1373f954..9b980cd7 100644
--- a/Libraries/LibGfx/CMakeLists.txt
+++ b/Libraries/LibGfx/CMakeLists.txt
@@ -116,6 +116,12 @@ if (HAS_VULKAN)
     target_link_libraries(LibGfx PUBLIC Vulkan::Headers)
     target_link_libraries(LibGfx PRIVATE Vulkan::Vulkan GPUOpen::VulkanMemoryAllocator)
 
+    if (LADYBIRD_UI_SFOS OR DEFINED ENV{LADYBIRD_UI_SFOS})
+        # libhybris exports most Vulkan entry points as IFUNCs whose resolvers only work once vkCreateInstance has
+        # loaded the Android driver, so they must not be bound when LibGfx loads.
+        target_link_options(LibGfx PRIVATE LINKER:-z,lazy)
+    endif()
+
     if (USE_VULKAN_DMABUF_IMAGES)
         pkg_check_modules(LibDRM REQUIRED libdrm)
         target_include_directories(LibGfx PUBLIC ${LibDRM_INCLUDE_DIRS})
diff --git a/Libraries/LibGfx/SkiaVulkanMemoryAllocator.cpp b/Libraries/LibGfx/SkiaVulkanMemoryAllocator.cpp
