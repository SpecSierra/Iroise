@@ -164,7 +164,12 @@ sk_sp<skgpu::VulkanMemoryAllocator> create_skia_vulkan_memory_allocator(VulkanCo
 {
     VmaVulkanFunctions functions = {};
     functions.vkGetInstanceProcAddr = vkGetInstanceProcAddr;
-    functions.vkGetDeviceProcAddr = vkGetDeviceProcAddr;
+    // NB: Call through a wrapper rather than storing the loader's address. libhybris exports this symbol as an
+    //     IFUNC, and a stored address would make the dynamic linker resolve it while the library loads, before
+    //     libhybris can find the Android driver.
+    functions.vkGetDeviceProcAddr = [](VkDevice device, char const* name) VKAPI_ATTR -> PFN_vkVoidFunction {
+        return vkGetDeviceProcAddr(device, name);
+    };
 
     VmaAllocatorCreateInfo info = {};
     // Skia only ever accesses the memory allocator from the thread that owns the GrDirectContext,
