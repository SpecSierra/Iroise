+/// Mirrors GC::PrimitiveStorage::default_cage_size in Libraries/LibGC/PrimitiveStorage.h.
+fn primitive_storage_cage_size(target: &Target) -> u64 {
+    let os = env::var("CARGO_CFG_TARGET_OS").expect("CARGO_CFG_TARGET_OS");
+    if matches!(target.architecture, flapc::Architecture::Aarch64) && os != "macos" {
+        64 * GIB
+    } else {
+        4 * TIB
+    }
+}
