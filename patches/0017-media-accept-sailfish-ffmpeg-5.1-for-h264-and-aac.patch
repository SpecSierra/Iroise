+// Below 60, FFmpeg numbers AV1 one higher than the headers the decoders are built with (see FFmpegFunctions.h).
+static bool numbers_codec_as_built(SystemFFmpeg const& library, CodecID codec_id)
+{
+    return library.major() >= 60 || codec_id != CodecID::AV1;
+}
