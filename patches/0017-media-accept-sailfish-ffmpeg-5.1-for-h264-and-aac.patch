diff --git a/Libraries/LibMedia/FFmpeg/SystemFFmpegDecoders.cpp b/Libraries/LibMedia/FFmpeg/SystemFFmpegDecoders.cpp
index 19647f7d8..e9ccf6aac 100644
--- a/Libraries/LibMedia/FFmpeg/SystemFFmpegDecoders.cpp
+++ b/Libraries/LibMedia/FFmpeg/SystemFFmpegDecoders.cpp
@@ -11,10 +11,16 @@
 
 namespace Media::FFmpeg {
 
+// Below 60, FFmpeg numbers AV1 one higher than the headers the decoders are built with (see FFmpegFunctions.h).
+static bool numbers_codec_as_built(SystemFFmpeg const& library, CodecID codec_id)
+{
+    return library.major() >= 60 || codec_id != CodecID::AV1;
+}
+
 Optional<DecoderCapabilities> system_ffmpeg_video_decoder_capabilities(ParsedCodec const& codec)
 {
     auto const* library = SystemFFmpeg::the();
-    if (library == nullptr)
+    if (library == nullptr || !numbers_codec_as_built(*library, codec.codec_id()))
         return {};
     return FFmpegVideoDecoder::capabilities(library->functions(), codec);
 }
@@ -30,7 +36,7 @@ Optional<DecoderCapabilities> system_ffmpeg_audio_decoder_capabilities(ParsedCod
 DecoderErrorOr<NonnullOwnPtr<VideoDecoder>> create_system_ffmpeg_video_decoder(CodecID codec_id, ReadonlyBytes codec_initialization_data)
 {
     auto const* library = SystemFFmpeg::the();
-    if (library == nullptr)
+    if (library == nullptr || !numbers_codec_as_built(*library, codec_id))
         return DecoderError::with_description(DecoderErrorCategory::NotImplemented, "No system FFmpeg is loaded"sv);
     return NonnullOwnPtr<VideoDecoder> { TRY(FFmpegVideoDecoder::try_create(library->functions(), codec_id, codec_initialization_data)) };
 }
diff --git a/Libraries/LibMediaCodecs/FFmpeg/FFmpegFunctions.h b/Libraries/LibMediaCodecs/FFmpeg/FFmpegFunctions.h
index d07e8c1ea..92ad284ef 100644
--- a/Libraries/LibMediaCodecs/FFmpeg/FFmpegFunctions.h
+++ b/Libraries/LibMediaCodecs/FFmpeg/FFmpegFunctions.h
@@ -21,9 +21,11 @@ extern "C" {
 
 // The decoders reach into these structs directly, so a libavcodec they run against must lay them out
 // this way. Every major from 60 through 63 does; a newer one is refused until it has been checked.
+// 59 (FFmpeg 5.1, Sailfish OS's) lays them out the same and numbers the codecs and formats the decoders use the same,
+// except AV1, which moved down by one in 6.0: SystemFFmpegDecoders refuses AV1 below 60.
 namespace Media::FFmpeg {
 
-constexpr unsigned LOWEST_SUPPORTED_LIBAVCODEC_MAJOR = 60;
+constexpr unsigned LOWEST_SUPPORTED_LIBAVCODEC_MAJOR = 59;
 constexpr unsigned HIGHEST_VERIFIED_LIBAVCODEC_MAJOR = 63;
 
 }
