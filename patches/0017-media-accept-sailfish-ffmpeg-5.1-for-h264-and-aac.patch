+// FFmpeg 7.0 added av_channel_layout_custom_init; for an older library, this does what it does, allocating with the
+// library's own av_malloc so that its av_channel_layout_uninit can free the map.
+static decltype(&::av_malloc) s_older_library_av_malloc;
+static int channel_layout_custom_init_for_older_library(AVChannelLayout* layout, int channel_count)
+{
+    if (channel_count <= 0)
+        return AVERROR(EINVAL);
+    auto* map = static_cast<AVChannelCustom*>(s_older_library_av_malloc(sizeof(AVChannelCustom) * static_cast<size_t>(channel_count)));
+    if (!map)
+        return AVERROR(ENOMEM);
+    memset(map, 0, sizeof(AVChannelCustom) * static_cast<size_t>(channel_count));
+    for (int i = 0; i < channel_count; i++)
+        map[i].id = AV_CHAN_UNKNOWN;
+    layout->order = AV_CHANNEL_ORDER_CUSTOM;
+    layout->nb_channels = channel_count;
+    layout->u.map = map;
+    layout->opaque = nullptr;
+    return 0;
+}
