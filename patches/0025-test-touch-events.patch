--- a/Libraries/LibWeb/Internals/Internals.cpp
+++ b/Libraries/LibWeb/Internals/Internals.cpp
@@ -835,6 +835,55 @@ void Internals::mouse_cancel()
     this->page().handle_mousecancel();
 }
 
+static Utf16String touch_event_result(EventResult result)
+{
+    switch (result) {
+    case EventResult::Accepted:
+        return "accepted"_utf16;
+    case EventResult::Handled:
+        return "handled"_utf16;
+    case EventResult::Cancelled:
+        return "cancelled"_utf16;
+    default:
+        return "dropped"_utf16;
+    }
+}
+
+static EventResult send_touch(Page& page, Web::MouseEvent::Type type, double x, double y)
+{
+    auto position = page.css_to_device_point({ x, y });
+    return page.handle_touch(page.local_traversable(), type, position, position, 0, nullptr);
+}
+
+Utf16String Internals::touch_start(double x, double y) { return touch_event_result(send_touch(page(), Web::MouseEvent::Type::TouchStart, x, y)); }
+Utf16String Internals::touch_move(double x, double y) { return touch_event_result(send_touch(page(), Web::MouseEvent::Type::TouchMove, x, y)); }
+Utf16String Internals::touch_end(double x, double y) { return touch_event_result(send_touch(page(), Web::MouseEvent::Type::TouchEnd, x, y)); }
+Utf16String Internals::touch_cancel(double x, double y) { return touch_event_result(send_touch(page(), Web::MouseEvent::Type::TouchCancel, x, y)); }
+
+Utf16String Internals::touch_scroll(double x, double y, double delta_x, double delta_y)
+{
+    auto& page = this->page();
+    auto position = page.css_to_device_point({ x, y });
+    page.set_handling_touch_scroll(true);
+    auto result = page.handle_mousewheel(page.local_traversable(), position, position, 0, 0, 0, delta_x, delta_y, 0, 0, Web::WheelDeltaPrecision::Precise, Web::ScrollGesturePhase::Ongoing, false, nullptr, nullptr);
+    page.set_handling_touch_scroll(false);
+    return touch_event_result(result);
+}
+
+void Internals::tap(double x, double y)
+{
+    auto& page = this->page();
+    send_touch(page, Web::MouseEvent::Type::TouchStart, x, y);
+    if (send_touch(page, Web::MouseEvent::Type::TouchEnd, x, y) == EventResult::Cancelled)
+        return;
+    auto position = page.css_to_device_point({ x, y });
+    page.set_handling_touch_compatibility(true);
+    page.handle_mousemove(position, position, 0, 0);
+    page.handle_mousedown(position, position, UIEvents::MouseButton::Primary, 0, 0, 1);
+    page.handle_mouseup(position, position, UIEvents::MouseButton::Primary, 0, 0);
+    page.set_handling_touch_compatibility(false);
+}
+
 void Internals::click(double x, double y, WebIDL::UnsignedShort click_count, WebIDL::UnsignedShort button, WebIDL::UnsignedShort modifiers)
 {
     click_and_hold(x, y, click_count, button, modifiers);
