@@ -0,0 +1,22 @@
+<!DOCTYPE html>
+<style>
+body { margin: 0; }
+#tile { width: 100px; height: 100px; }
+</style>
+<div id="tile"></div>
+<script src="../include.js"></script>
+<script>
+    // The pointer of a touch whose element left the document goes on at the document, so that a page counting the
+    // pointers that are down there (a map's) still hears it go up. The touch's own events stay with the element
+    // (Pacific, patches/0023).
+    test(() => {
+        const name = target => target === document ? "document" : target.id;
+        document.addEventListener("pointerdown", event => println(`pointerdown at ${name(event.target)}`));
+        document.addEventListener("pointerup", event => println(`pointerup at ${name(event.target)}`));
+        tile.addEventListener("touchend", event => println(`touchend at ${name(event.target)}`));
+
+        internals.touchStart(50, 50);
+        tile.remove();
+        internals.touchEnd(50, 50);
+    });
+</script>
diff --git a/Tests/LibWeb/Text/input/UIEvents/touch-scroll-decided-by-touchmove.html b/Tests/LibWeb/Text/input/UIEvents/touch-scroll-decided-by-touchmove.html
new file mode 100644
index 00000000..96ea5718
--- /dev/null
+++ b/Tests/LibWeb/Text/input/UIEvents/touch-scroll-decided-by-touchmove.html
@@ -0,0 +1,34 @@
+<!DOCTYPE html>
+<style>
+body { margin: 0; height: 3000px; }
+div { width: 100px; height: 100px; }
+</style>
+<div id="holds"></div>
+<div id="lets"></div>
+<script src="../include.js"></script>
+<script>
+    // A cancelled touchmove keeps the finger from scrolling. A step the page lets through scrolls: the touch's pointer
+    // is cancelled, and its touchmoves can no longer be cancelled (Pacific, patches/0022 and 0023).
+    test(() => {
+        holds.addEventListener("touchmove", event => event.preventDefault());
+        for (const element of [holds, lets]) {
+            for (const type of ["pointermove", "pointercancel", "pointerup"])
+                element.addEventListener(type, () => println(`  ${element.id}: ${type}`));
+            element.addEventListener("touchmove", event => println(`  ${element.id}: touchmove, cancelable ${event.cancelable}`));
+        }
+
+        println("cancelled touchmove:");
+        internals.touchStart(50, 50);
+        internals.touchMove(50, 40);
+        println(`  scroll step cancelled: ${internals.touchScroll(50, 40, 0, 10) === "cancelled"}`);
+        internals.touchMove(50, 30);
+        internals.touchEnd(50, 30);
+
+        println("touchmove not cancelled:");
+        internals.touchStart(50, 150);
+        internals.touchMove(50, 140);
+        println(`  scroll step cancelled: ${internals.touchScroll(50, 140, 0, 10) === "cancelled"}`);
+        internals.touchMove(50, 130);
+        internals.touchEnd(50, 130);
+    });
+</script>
