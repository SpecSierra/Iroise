@@ -0,0 +1,22 @@
+<!DOCTYPE html>
+<style>
+body { margin: 0; }
+#target { width: 100px; height: 100px; }
+</style>
+<div id="target"></div>
+<script src="../include.js"></script>
+<script>
+    // A tap fires the pointer events of its touch, its touch events, then the mouse events of a tap, with no mouse
+    // pointer events of their own (Pacific, patches/0021 to 0024).
+    test(() => {
+        const types = ["pointerover", "pointerenter", "pointerdown", "pointermove", "pointerup", "pointercancel",
+            "pointerout", "pointerleave", "touchstart", "touchmove", "touchend", "touchcancel", "mouseover",
+            "mouseenter", "mousemove", "mousedown", "mouseup", "click"];
+        for (const type of types) {
+            target.addEventListener(type, event => {
+                println(event.pointerType !== undefined && type.startsWith("pointer") ? `${type} (${event.pointerType})` : type);
+            });
+        }
+        internals.tap(50, 50);
+    });
+</script>
