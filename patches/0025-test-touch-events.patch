@@ -0,0 +1,34 @@
+<!DOCTYPE html>
+<style>
+body { margin: 0; }
+#target { width: 100px; height: 100px; margin-left: 20px; }
+</style>
+<div id="target"></div>
+<script src="../include.js"></script>
+<script>
+    // Touch, TouchList and TouchEvent, ontouchstart and the rest, and what a touch's events carry (Pacific,
+    // patches/0021 to 0023).
+    test(() => {
+        println(`ontouchstart in window: ${"ontouchstart" in window}`);
+        println(`ontouchend in an element: ${"ontouchend" in document.createElement("div")}`);
+        const constructed = new TouchEvent("touchstart", { bubbles: true, ctrlKey: true });
+        println(`constructed: ${constructed.type}, bubbles ${constructed.bubbles}, ctrlKey ${constructed.ctrlKey}, touches ${constructed.touches.length}`);
+
+        window.attributeHandlerRan = false;
+        target.setAttribute("ontouchstart", "window.attributeHandlerRan = true");
+        target.addEventListener("pointerdown", event => {
+            println(`pointerdown: ${event.pointerType}, primary ${event.isPrimary}, pressure ${event.pressure}, buttons ${event.buttons}, id over 1 ${event.pointerId > 1}`);
+        });
+        target.addEventListener("touchstart", event => {
+            const touch = event.changedTouches[0];
+            println(`touchstart: trusted ${event.isTrusted}, cancelable ${event.cancelable}, touches ${event.touches.length}, changed ${event.changedTouches.length}`);
+            println(`touch: target ${touch.target.id}, client ${touch.clientX},${touch.clientY}, item(0) is it ${event.touches.item(0) === touch}`);
+        });
+        target.addEventListener("touchend", event => {
+            println(`touchend: touches ${event.touches.length}, changed ${event.changedTouches.length}`);
+        });
+        internals.touchStart(30, 40);
+        internals.touchEnd(30, 40);
+        println(`attribute handler ran: ${window.attributeHandlerRan}`);
+    });
+</script>
