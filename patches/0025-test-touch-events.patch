@@ -0,0 +1,35 @@
+<!DOCTYPE html>
+<style>
+body { margin: 0; height: 3000px; width: 3000px; }
+div { width: 100px; height: 100px; }
+#none { touch-action: none; }
+#pan-y, #pan-y-down { touch-action: pan-y; }
+#outer { touch-action: none; height: auto; }
+</style>
+<div id="none"></div>
+<div id="pan-y"></div>
+<div id="pan-y-down"></div>
+<div id="outer"><div id="inner"></div></div>
+<script src="../include.js"></script>
+<script>
+    // https://w3c.github.io/pointerevents/#the-touch-action-css-property
+    // touch-action decides whether a finger pans: the touchstart tells a UI when no panning is allowed, a direction the
+    // page keeps does not scroll, and a pointer the page keeps is not cancelled (Pacific, patches/0023).
+    test(() => {
+        for (const element of document.querySelectorAll("div")) {
+            for (const type of ["pointermove", "pointercancel"])
+                element.addEventListener(type, () => println(`  ${element.id}: ${type}`));
+        }
+        function finger(name, x, y, deltaX, deltaY) {
+            println(`${name}:`);
+            println(`  touchstart cancelled: ${internals.touchStart(x, y) === "cancelled"}`);
+            println(`  scroll step cancelled: ${internals.touchScroll(x, y, deltaX, deltaY) === "cancelled"}`);
+            internals.touchMove(x + 1, y + 1);
+            internals.touchEnd(x + 1, y + 1);
+        }
+        finger("none", 50, 50, 0, 10);
+        finger("pan-y, sideways", 50, 150, 10, 0);
+        finger("pan-y, down", 50, 250, 0, 10);
+        finger("none on an ancestor", 50, 350, 0, 10);
+    });
+</script>
diff --git a/Tests/LibWeb/Text/input/UIEvents/touch-cancelled-touch-has-no-mouse-events.html b/Tests/LibWeb/Text/input/UIEvents/touch-cancelled-touch-has-no-mouse-events.html
new file mode 100644
index 00000000..0ff9d555
--- /dev/null
+++ b/Tests/LibWeb/Text/input/UIEvents/touch-cancelled-touch-has-no-mouse-events.html
@@ -0,0 +1,33 @@
+<!DOCTYPE html>
+<style>
+body { margin: 0; }
+div { width: 100px; height: 100px; }
+</style>
+<div id="start"></div>
+<div id="end"></div>
+<div id="down"></div>
+<script src="../include.js"></script>
+<script>
+    // https://w3c.github.io/touch-events/#mouse-events
+    // A cancelled touchstart or touchend keeps a tap from becoming mouse events. A cancelled pointerdown keeps only its
+    // mousedown and mouseup from firing: its click still does.
+    test(() => {
+        function listen(element) {
+            for (const type of ["mousedown", "mouseup", "click"])
+                element.addEventListener(type, () => println(`  ${element.id}: ${type}`));
+        }
+        listen(start);
+        listen(end);
+        listen(down);
+        start.addEventListener("touchstart", event => event.preventDefault());
+        end.addEventListener("touchend", event => event.preventDefault());
+        down.addEventListener("pointerdown", event => event.preventDefault());
+
+        println("touchstart cancelled:");
+        internals.tap(50, 50);
+        println("touchend cancelled:");
+        internals.tap(50, 150);
+        println("pointerdown cancelled:");
+        internals.tap(50, 250);
+    });
+</script>
diff --git a/Tests/LibWeb/Text/input/UIEvents/touch-event-interfaces.html b/Tests/LibWeb/Text/input/UIEvents/touch-event-interfaces.html
