+// IROISE DIAGNOSTIC, not for main: with LADYBIRD_IROISE_COMPOSITOR_TRACE set (helpers only see LADYBIRD_* variables), once a second, what presenting frames cost.
+struct IroiseTrace {
+    bool enabled { Core::Environment::get("LADYBIRD_IROISE_COMPOSITOR_TRACE"sv).has_value() };
+    u64 frames { 0 };
+    u64 damage_area { 0 };
+    u64 raster_area { 0 };
+    u64 full_area { 0 };
+    u64 full_frames { 0 };
+    u64 paint_us { 0 };
+    u64 flush_us { 0 };
+    Gfx::IntRect last_damage;
+    MonotonicTime last { MonotonicTime::now() };
+    void report()
+    {
+        auto now = MonotonicTime::now();
+        if ((now - last).to_milliseconds() < 1000)
+            return;
+        if (frames > 0) {
+            dbgln("[iroise-trace] {} frames, damage {}% raster {}% of the viewport, {} full-viewport, paint {} us, flush {} us per frame, last damage {}",
+                frames, damage_area * 100 / max<u64>(full_area, 1), raster_area * 100 / max<u64>(full_area, 1), full_frames, paint_us / frames, flush_us / frames, last_damage);
+        }
+        frames = damage_area = raster_area = full_area = full_frames = paint_us = flush_us = 0;
+        last = now;
+    }
+};
+static IroiseTrace& iroise_trace()
+{
+    static IroiseTrace trace;
+    return trace;
+}
+void iroise_trace_flush(u64 microseconds);
+void iroise_trace_flush(u64 microseconds)
+{
+    if (iroise_trace().enabled)
+        iroise_trace().flush_us += microseconds;
+}
