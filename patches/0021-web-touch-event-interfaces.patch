@@ -0,0 +1,52 @@
+/*
+ * Copyright (c) 2026, the Pacific developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <LibWeb/Bindings/Wrappable.h>
+#include <LibWeb/DOM/EventTarget.h>
+#include <LibWebCommon/PixelUnits.h>
+
+namespace Web::UIEvents {
+
+// https://w3c.github.io/touch-events/#touch-interface
+class Touch final : public Bindings::GCAllocatedWrappable {
+    WEB_WRAPPABLE(Touch, Bindings::GCAllocatedWrappable);
+    GC_DECLARE_ALLOCATOR(Touch);
+
+public:
+    // `client` is relative to the viewport, `page` to the initial containing block.
+    [[nodiscard]] static GC::Ref<Touch> create(i32 identifier, GC::Ref<DOM::EventTarget>, CSSPixelPoint screen, CSSPixelPoint client, CSSPixelPoint page, float radius);
+    virtual ~Touch() override;
+
+    i32 identifier() const { return m_identifier; }
+    GC::Ref<DOM::EventTarget> target() const { return m_target; }
+    double screen_x() const { return m_screen.x().to_double(); }
+    double screen_y() const { return m_screen.y().to_double(); }
+    double client_x() const { return m_client.x().to_double(); }
+    double client_y() const { return m_client.y().to_double(); }
+    double page_x() const { return m_page.x().to_double(); }
+    double page_y() const { return m_page.y().to_double(); }
+    float radius_x() const { return m_radius; }
+    float radius_y() const { return m_radius; }
+    float rotation_angle() const { return 0; }
+    // NB: The screen does not tell how hard a finger presses.
+    float force() const { return 0; }
+
+private:
+    Touch(i32 identifier, GC::Ref<DOM::EventTarget>, CSSPixelPoint screen, CSSPixelPoint client, CSSPixelPoint page, float radius);
+
+    virtual void visit_edges(GC::Cell::Visitor&) override;
+
+    i32 m_identifier { 0 };
+    GC::Ref<DOM::EventTarget> m_target;
+    CSSPixelPoint m_screen;
+    CSSPixelPoint m_client;
+    CSSPixelPoint m_page;
+    float m_radius { 0 };
+};
+
+}
