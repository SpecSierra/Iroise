+/*
+ * Copyright (c) 2026, the Pacific developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Heap.h>
+#include <LibWeb/UIEvents/Touch.h>
+
+namespace Web::UIEvents {
+
+GC_DEFINE_ALLOCATOR(Touch);
+
+GC::Ref<Touch> Touch::create(i32 identifier, GC::Ref<DOM::EventTarget> target, CSSPixelPoint screen, CSSPixelPoint client, CSSPixelPoint page, float radius)
+{
+    return GC::Heap::the().allocate<Touch>(identifier, target, screen, client, page, radius);
+}
+
+Touch::Touch(i32 identifier, GC::Ref<DOM::EventTarget> target, CSSPixelPoint screen, CSSPixelPoint client, CSSPixelPoint page, float radius)
+    : m_identifier(identifier)
+    , m_target(target)
+    , m_screen(screen)
+    , m_client(client)
+    , m_page(page)
+    , m_radius(radius)
+{
+}
+
+Touch::~Touch() = default;
+
+void Touch::visit_edges(GC::Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_target);
+}
+
+}
diff --git a/Libraries/LibWeb/UIEvents/Touch.h b/Libraries/LibWeb/UIEvents/Touch.h
