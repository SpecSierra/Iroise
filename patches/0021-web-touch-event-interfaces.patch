+// https://w3c.github.io/touch-events/#touch-interface
+// FIXME: The constructor, and altitudeAngle, azimuthAngle and touchType.
+[Exposed=Window]
+interface Touch {
+    readonly attribute long identifier;
+    readonly attribute EventTarget target;
+    readonly attribute double screenX;
+    readonly attribute double screenY;
+    readonly attribute double clientX;
+    readonly attribute double clientY;
+    readonly attribute double pageX;
+    readonly attribute double pageY;
+    readonly attribute float radiusX;
+    readonly attribute float radiusY;
+    readonly attribute float rotationAngle;
+    readonly attribute float force;
+};
diff --git a/Libraries/LibWeb/UIEvents/TouchEvent.cpp b/Libraries/LibWeb/UIEvents/TouchEvent.cpp
new file mode 100644
index 00000000..4b6076fb
--- /dev/null
+++ b/Libraries/LibWeb/UIEvents/TouchEvent.cpp
@@ -0,0 +1,98 @@
+/*
+ * Copyright (c) 2026, the Pacific developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Heap.h>
+#include <LibWeb/UIEvents/TouchEvent.h>
+#include <LibWebCommon/UIEvents/KeyCode.h>
+
+namespace Web::UIEvents {
+
+GC_DEFINE_ALLOCATOR(TouchEvent);
+
+GC::Ref<TouchEvent> TouchEvent::create_from_platform_event(Utf16FlyString const& event_name, GC::Ptr<HTML::WindowProxy> view, GC::Ref<TouchList> touches, GC::Ref<TouchList> target_touches, GC::Ref<TouchList> changed_touches, unsigned modifiers, bool cancelable, HighResolutionTime::DOMHighResTimeStamp time_stamp)
+{
+    TouchEventInit event_init;
+    event_init.view = view;
+    event_init.ctrl_key = modifiers & Mod_Ctrl;
+    event_init.shift_key = modifiers & Mod_Shift;
+    event_init.alt_key = modifiers & Mod_Alt;
+    event_init.meta_key = modifiers & Mod_Super;
+    auto event = GC::Heap::the().allocate<TouchEvent>(event_name, event_init, time_stamp);
+    event->m_touches = touches;
+    event->m_target_touches = target_touches;
+    event->m_changed_touches = changed_touches;
+    event->set_is_trusted(true);
+    event->set_bubbles(true);
+    event->set_cancelable(cancelable);
+    event->set_composed(true);
+    return event;
+}
+
+GC::Ref<TouchEvent> TouchEvent::create_for_constructor(FlyString const& event_name, TouchEventInit const& event_init, HighResolutionTime::DOMHighResTimeStamp time_stamp)
+{
+    return GC::Heap::the().allocate<TouchEvent>(event_name, event_init, time_stamp);
+}
+
+GC::Ref<TouchEvent> TouchEvent::create_for_constructor(Utf16String const& event_name, TouchEventInit const& event_init, HighResolutionTime::DOMHighResTimeStamp time_stamp)
+{
+    return GC::Heap::the().allocate<TouchEvent>(Utf16FlyString::from_utf16(event_name.utf16_view()), event_init, time_stamp);
+}
+
+TouchEvent::TouchEvent(FlyString const& event_name, TouchEventInit const& event_init, HighResolutionTime::DOMHighResTimeStamp time_stamp)
+    : UIEvent(event_name, event_init, time_stamp)
+{
+    initialize_from(event_init);
+}
+
+TouchEvent::TouchEvent(Utf16FlyString const& event_name, TouchEventInit const& event_init, HighResolutionTime::DOMHighResTimeStamp time_stamp)
+    : UIEvent(event_name, event_init, time_stamp)
+{
+    initialize_from(event_init);
+}
+
+TouchEvent::~TouchEvent() = default;
+
+void TouchEvent::initialize_from(TouchEventInit const& event_init)
+{
+    auto list = [](auto const& touches) {
+        Vector<GC::Ref<Touch>> list;
+        list.ensure_capacity(touches.size());
+        for (auto const& touch : touches)
+            list.unchecked_append(touch);
+        return TouchList::create(move(list));
+    };
+    m_touches = list(event_init.touches);
+    m_target_touches = list(event_init.target_touches);
+    m_changed_touches = list(event_init.changed_touches);
+    m_alt_key = event_init.alt_key;
+    m_meta_key = event_init.meta_key;
+    m_ctrl_key = event_init.ctrl_key;
+    m_shift_key = event_init.shift_key;
+}
+
+void TouchEvent::visit_edges(GC::Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_touches);
+    visitor.visit(m_target_touches);
+    visitor.visit(m_changed_touches);
+}
+
+// https://w3c.github.io/uievents/#dom-mouseevent-getmodifierstate
+bool TouchEvent::get_modifier_state(Utf16FlyString const& key_arg) const
+{
+    if (key_arg == "Control"_utf16_fly_string)
+        return m_ctrl_key;
+    if (key_arg == "Shift"_utf16_fly_string)
+        return m_shift_key;
+    if (key_arg == "Alt"_utf16_fly_string)
+        return m_alt_key;
+    if (key_arg == "Meta"_utf16_fly_string)
+        return m_meta_key;
+    return false;
+}
+
+}
