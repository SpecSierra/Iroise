+/*
+ * Copyright (c) 2026, the Pacific developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/FlyString.h>
+#include <AK/Utf16FlyString.h>
+#include <AK/Utf16String.h>
+#include <LibWeb/Bindings/TouchEvent.h>
+#include <LibWeb/UIEvents/TouchList.h>
+#include <LibWeb/UIEvents/UIEvent.h>
+#include <LibWebCommon/HighResolutionTime/DOMHighResTimeStamp.h>
+
+namespace Web::UIEvents {
+
+using TouchEventInit = Bindings::TouchEventInit;
+
+// https://w3c.github.io/touch-events/#touchevent-interface
+class TouchEvent final : public UIEvent {
+    WEB_WRAPPABLE(TouchEvent, UIEvent);
+    GC_DECLARE_ALLOCATOR(TouchEvent);
+
+public:
+    // A touch event of the user's: trusted, bubbling and composed. It can be cancelled if `cancelable`.
+    [[nodiscard]] static GC::Ref<TouchEvent> create_from_platform_event(Utf16FlyString const& event_name, GC::Ptr<HTML::WindowProxy>, GC::Ref<TouchList> touches, GC::Ref<TouchList> target_touches, GC::Ref<TouchList> changed_touches, unsigned modifiers, bool cancelable, HighResolutionTime::DOMHighResTimeStamp);
+    [[nodiscard]] static GC::Ref<TouchEvent> create_for_constructor(FlyString const& event_name, TouchEventInit const&, HighResolutionTime::DOMHighResTimeStamp);
+    [[nodiscard]] static GC::Ref<TouchEvent> create_for_constructor(Utf16String const& event_name, TouchEventInit const&, HighResolutionTime::DOMHighResTimeStamp);
+    virtual ~TouchEvent() override;
+
+    GC::Ref<TouchList> touches() const { return *m_touches; }
+    GC::Ref<TouchList> target_touches() const { return *m_target_touches; }
+    GC::Ref<TouchList> changed_touches() const { return *m_changed_touches; }
+    bool alt_key() const { return m_alt_key; }
+    bool meta_key() const { return m_meta_key; }
+    bool ctrl_key() const { return m_ctrl_key; }
+    bool shift_key() const { return m_shift_key; }
+    bool get_modifier_state(Utf16FlyString const& key_arg) const;
+
+private:
+    TouchEvent(FlyString const& event_name, TouchEventInit const&, HighResolutionTime::DOMHighResTimeStamp);
+    TouchEvent(Utf16FlyString const& event_name, TouchEventInit const&, HighResolutionTime::DOMHighResTimeStamp);
+
+    void initialize_from(TouchEventInit const&);
+    virtual void visit_edges(GC::Cell::Visitor&) override;
+
+    GC::Ptr<TouchList> m_touches;
+    GC::Ptr<TouchList> m_target_touches;
+    GC::Ptr<TouchList> m_changed_touches;
+    bool m_alt_key { false };
+    bool m_meta_key { false };
+    bool m_ctrl_key { false };
+    bool m_shift_key { false };
+};
+
+}
diff --git a/Libraries/LibWeb/UIEvents/TouchEvent.idl b/Libraries/LibWeb/UIEvents/TouchEvent.idl
