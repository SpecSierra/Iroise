+/*
+ * Copyright (c) 2026, the Pacific developers.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <LibGC/Heap.h>
+#include <LibWeb/UIEvents/TouchList.h>
+
+namespace Web::UIEvents {
+
+GC_DEFINE_ALLOCATOR(TouchList);
+
+GC::Ref<TouchList> TouchList::create(Vector<GC::Ref<Touch>> touches)
+{
+    return GC::Heap::the().allocate<TouchList>(move(touches));
+}
+
+TouchList::TouchList(Vector<GC::Ref<Touch>> touches)
+    : m_touches(move(touches))
+{
+}
+
+TouchList::~TouchList() = default;
+
+void TouchList::visit_edges(GC::Cell::Visitor& visitor)
+{
+    Base::visit_edges(visitor);
+    visitor.visit(m_touches);
+}
+
+// https://w3c.github.io/touch-events/#dom-touchlist-item
+Touch const* TouchList::item(u32 index) const
+{
+    if (index >= m_touches.size())
+        return nullptr;
+    return m_touches[index].ptr();
+}
+
+}
