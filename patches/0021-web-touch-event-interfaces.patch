+ */
+
+#pragma once
+
+#include <AK/Vector.h>
+#include <LibWeb/Bindings/Wrappable.h>
+#include <LibWeb/UIEvents/Touch.h>
+
+namespace Web::UIEvents {
+
+// https://w3c.github.io/touch-events/#touchlist-interface
+class TouchList final : public Bindings::GCAllocatedWrappable {
+    WEB_WRAPPABLE(TouchList, Bindings::GCAllocatedWrappable);
+    GC_DECLARE_ALLOCATOR(TouchList);
+
+public:
+    [[nodiscard]] static GC::Ref<TouchList> create(Vector<GC::Ref<Touch>>);
+    virtual ~TouchList() override;
+
+    u32 length() const { return m_touches.size(); }
+    Touch const* item(u32 index) const;
+
+private:
+    explicit TouchList(Vector<GC::Ref<Touch>>);
+
+    virtual void visit_edges(GC::Cell::Visitor&) override;
+
+    Vector<GC::Ref<Touch>> m_touches;
+};
+
+}
